# Public application origin. Use the deployed HTTPS origin outside local development.
APP_BASE_URL=http://localhost:3000

# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Phase 0 only: leave unset until Panta supplies and verifies the environment.
# Do not expose either value through a NEXT_PUBLIC_ variable.
PANTA_API_BASE_URL=
PANTA_API_KEY=
